{
  "name": "dynata-sig-ts",
  "version": "0.1.0",
  "description": "Dynata request signing SDK for Node.js in TypeScript.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/@dynata"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
